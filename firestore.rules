rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'doctor'
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // Patients collection - Patients can read/write their own record; staff can manage
    match /patients/{patientId} {
      allow read, write: if isOwner(patientId) || isStaff();
    }

    // Medical history - strictly private to owner and clinical staff
    match /medical_history/{historyId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow write: if isStaff() || (isAuthenticated() && request.resource.data.patientId == request.auth.uid);
    }

    // Conversations - chat sessions
    match /conversations/{conversationId} {
      allow read, write: if isStaff() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
    }

    // Patient Intake records
    match /patient_intake/{intakeId} {
      allow read, write: if isStaff() || (isAuthenticated() && request.resource.data.patientId == request.auth.uid);
    }

    // Triage Assessments - critical safety records
    match /triage_assessments/{triageId} {
      allow read: if isAuthenticated();
      allow write: if isStaff() || isAuthenticated();
    }

    // Doctors and doctor availability - public read for booking, write restricted to staff
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /doctor_availability/{availId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Appointments - Patient can view their own; Staff can manage all
    match /appointments/{appointmentId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isStaff() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
    }

    // Rebooking requests & cancellations
    match /rebooking_requests/{requestId} {
      allow read, write: if isStaff() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
    }

    // Human approvals queue - staff only
    match /human_approvals/{approvalId} {
      allow read, write: if isStaff();
    }

    // Email notifications audit trail
    match /email_notifications/{notifId} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.patientEmail == request.auth.token.email);
      allow write: if isStaff();
    }

    // Agent execution logs & evaluation results - staff observability
    match /agent_execution_logs/{logId} {
      allow read, write: if isStaff();
    }

    match /evaluation_results/{evalId} {
      allow read, write: if isStaff();
    }

    // Benchmark and test data collections - staff only
    match /triage_test_data/{testId} {
      allow read, write: if isStaff();
    }

    match /evaluation_test_cases/{caseId} {
      allow read, write: if isStaff();
    }
  }
}
