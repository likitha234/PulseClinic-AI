# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Configuration
FIREBASE_PROJECT_ID="pulseclinic-ai"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Browserbase Cloud Browser Automation API
# Used by backend tool browserbase_check_schedule to inspect doctor schedules in real sessions
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""

# Resend Email API
# Used to dispatch appointment confirmations, rescheduling notifications, and cancellations
RESEND_API_KEY=""

# Clinic Metadata
CLINIC_NAME="PulseCare Medical Center"
CLINIC_ADDRESS="742 Evergreen Terrace, Medical Suite 400, Springfield"
